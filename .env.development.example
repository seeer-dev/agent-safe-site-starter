# Local development inventory — placeholders only, never real credentials.
#
# Copy to `.env.development.local` (git-ignored) and fill in as needed:
#
#     cp .env.development.example .env.development.local
#
# Precedence for local runs: process environment > .env.development.local > .env
# `.env` is the legacy location and still works, so an existing setup keeps
# running. New setups should use `.env.development.local`.
#
# None of this file is read when APP_ENV=production. See
# `.env.production.example` and `docs/environment-configuration.md`.

APP_ENV=development
HTTP_ADDR=:8080
SITE_ADDR=:4173
SITE_ORIGIN=http://localhost:4173
PUBLIC_SITE_URL=http://localhost:4173
PUBLIC_API_BASE=http://localhost:8080

# Optional admin API prefix. Leave unset locally so the Vite dev proxy serves
# /api. When set, it must be a complete prefix ending in /api and use HTTPS
# (e.g. https://api.example.com/api); HTTP is allowed only for
# localhost / 127.0.0.1 / [::1]. Any invalid value falls back to /api.
# ADMIN_API_BASE=

# PostgreSQL connection pool bounds. Ignored for SQLite, which is always
# limited to one connection. Leave unset locally; the defaults apply.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m

# Edge-to-origin shared secret. Leave unset locally: when empty the check is
# absent and the API behaves exactly as before.
# EDGE_SECRET=

DB_DRIVER=sqlite
DATABASE_URL=file:var/site.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Local protected API calls use this token. Server-only — never reaches a
# browser bundle.
AUTH_MODE=dev
DEV_AUTH_TOKEN=dev-admin

# Supabase (only needed locally when testing AUTH_MODE=supabase).
# SUPABASE_PUBLISHABLE_KEY is a public client identifier, not a server secret.
# SUPABASE_VERIFIER_MODE selects token verification mode: "remote" (default)
# calls /auth/v1/user; "jwks" verifies asymmetric JWTs locally against the
# derived /.well-known/jwks.json endpoint.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_VERIFIER_MODE=remote

# Non-secret browser OAuth flags. Empty/false/unknown is fail-closed.
# Never put a Google or LINE client secret in this file.
# Enable LINE only after the LINE channel has email permission.
AUTH_GOOGLE_ENABLED=false
AUTH_LINE_ENABLED=false

# R2 (optional locally; media upload is disabled until all four are set).
# Server-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Resend (optional locally; without an API key mail is written to the log).
# Server-only.
RESEND_API_KEY=
RESEND_FROM=Site <hello@example.com>
CONTACT_NOTIFY_TO=

# Cloudflare Pages direct upload (optional locally). Server-only.
CF_PAGES_PROJECT=
CF_DEPLOY_HOOK_URL=
