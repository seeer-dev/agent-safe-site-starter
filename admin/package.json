{
  "name": "ai-site-starter-admin",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev:admin": "pnpm --filter @sitecore/admin dev",
    "build:admin": "pnpm --filter @sitecore/admin build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "pnpm -r --if-present test:unit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vue/compiler-sfc": "3.5.41",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "typescript-eslint": "8.66.0",
    "typescript": "6.0.3"
  }
}
