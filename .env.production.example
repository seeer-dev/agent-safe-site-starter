# Production inventory — a CHECKLIST, not a deployable file.
#
# Do NOT create a real `.env.production` and do NOT deploy one. Production
# values live in the provider's own environment:
#
#   Railway            -> Go API process environment
#   Cloudflare Pages   -> build environment for the Go renderer and the
#                         admin / public-theme Vite builds
#
# When APP_ENV=production, the Go loader reads the process environment only
# and ignores every repository dotenv file. Both Vite builds do the same for
# production mode. That is the deployment boundary: nothing in this repository
# can supply a production value.
#
# Columns below mark where each name belongs:
#   [railway]  Go API process environment
#   [pages]    Cloudflare Pages build environment
#   [browser]  additionally compiled into browser assets — public values only
#
# See docs/environment-configuration.md for the full ownership table.

# ---- Deployment boundary -------------------------------------------------
APP_ENV=production                      # [railway] [pages] required

# ---- URLs and origins ----------------------------------------------------
HTTP_ADDR=:8080                         # [railway]
SITE_ORIGIN=                            # [railway] exact browser origin allowed by CORS
PUBLIC_SITE_URL=                        # [railway] [pages] canonical public site URL
PUBLIC_API_BASE=                        # [railway] [pages] public API origin
ADMIN_API_BASE=                         # [pages] [browser] complete prefix ending in /api, HTTPS

# ---- Database ------------------------------------------------------------
DB_DRIVER=postgres                      # [railway] [pages]
DATABASE_URL=                           # [railway] [pages] SECRET — Supabase PostgreSQL connection string

# ---- Authentication ------------------------------------------------------
AUTH_MODE=supabase                      # [railway] [pages] [browser] AUTH_MODE=dev is rejected in production
SUPABASE_URL=                           # [railway] [pages] [browser]
SUPABASE_PUBLISHABLE_KEY=               # [railway] [pages] [browser] public client identifier
AUTH_GOOGLE_ENABLED=                    # [pages] [browser] non-secret flag
AUTH_LINE_ENABLED=                      # [pages] [browser] non-secret flag
# DEV_AUTH_TOKEN                        # never set in production

# OAuth client secrets are configured in the Supabase dashboard, not here and
# never in a browser bundle.

# ---- Object storage (Cloudflare R2) --------------------------------------
R2_ACCOUNT_ID=                          # [railway] SECRET
R2_ACCESS_KEY_ID=                       # [railway] SECRET
R2_SECRET_ACCESS_KEY=                   # [railway] SECRET
R2_BUCKET=                              # [railway]
R2_PUBLIC_BASE_URL=                     # [railway] [pages] public asset origin

# ---- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=                         # [railway] SECRET
RESEND_FROM=                            # [railway]
CONTACT_NOTIFY_TO=                      # [railway]

# ---- Publishing ----------------------------------------------------------
CF_PAGES_PROJECT=                       # [pages] direct-upload publishing
CF_DEPLOY_HOOK_URL=                     # [railway] SECRET — deploy hook

# Values marked SECRET must never appear in admin/dist/ or
# site/themes/minimal-cart/dist/. Only the [browser] names cross that
# boundary, and the allowlist is enforced in both vite.config.ts files.
