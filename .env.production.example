# Production inventory — a CHECKLIST, not a deployable file.
#
# Do NOT create a real `.env.production` and do NOT deploy one. Production
# values live in the provider's own environment:
#
#   Railway            -> Go API process environment
#   Cloudflare Pages   -> build environment for the Go renderer and the
#                         admin / public-theme Vite builds
#
# When APP_ENV=production, the Go loader reads the process environment only
# and ignores every repository dotenv file. Both Vite builds do the same for
# production mode. That is the deployment boundary: nothing in this repository
# can supply a production value.
#
# Columns below mark where each name belongs:
#   [railway]  Go API process environment
#   [pages]    Cloudflare Pages build environment
#   [browser]  additionally compiled into browser assets — public values only
#
# See docs/environment-configuration.md for the full ownership table.

# ---- Deployment boundary -------------------------------------------------
APP_ENV=production                      # [railway] [pages] required

# ---- URLs and origins ----------------------------------------------------
HTTP_ADDR=:8080                         # [railway]
SITE_ORIGIN=                            # [railway] exact browser origin allowed by CORS
EDGE_SECRET=                            # [railway] SECRET + [pages-fn] SECRET — injected by the Pages Function; refuses requests that did not pass the edge
EDGE_SECRET_PREVIOUS=                   # [railway] SECRET — rotation window only: the outgoing EDGE_SECRET stays accepted while both Pages projects switch to the new value; unset it once rotation completes
PUBLIC_SITE_URL=                        # [railway] [pages] canonical public site URL
PUBLIC_API_BASE=                        # [railway] [pages] the SITE origin (https://你的網域) — browsers call same-origin /api/* and the Pages Function proxies it; Railway also uses it for the ECPay ReturnURL
ADMIN_API_BASE=                         # [pages] [browser] leave UNSET — defaults to same-origin /api via the Pages Function

# ---- Pages Functions env (runtime vars on BOTH Pages projects) ------------
# These are not build vars and not compiled into any bundle. Set them under
# Pages project -> Settings -> Environment variables for the storefront AND
# the admin project; both pick up repo-root functions/api/[[path]].js.
API_ORIGIN=                             # [pages-fn] Railway public URL, e.g. https://xxx.up.railway.app
# EDGE_SECRET listed above — same value as on Railway.

# ---- Database ------------------------------------------------------------
DB_DRIVER=postgres                      # [railway] [pages]
DATABASE_URL=                           # [railway] [pages] SECRET — Supabase PostgreSQL connection string
DB_MAX_OPEN_CONNS=                      # [railway] default 10; size to the instance and the pooler in front of it
DB_MAX_IDLE_CONNS=                      # [railway] default 10; clamped to DB_MAX_OPEN_CONNS
DB_CONN_MAX_LIFETIME=                   # [railway] default 30m; lets a pooler or load balancer rotate connections
DB_CONN_MAX_IDLE_TIME=                  # [railway] default 5m

# ---- Authentication ------------------------------------------------------
AUTH_MODE=supabase                      # [railway] [pages] [browser] AUTH_MODE=dev is rejected in production
SUPABASE_URL=                           # [railway] [pages] [browser]
SUPABASE_PUBLISHABLE_KEY=               # [railway] [pages] [browser] public client identifier
SUPABASE_VERIFIER_MODE=remote           # [railway] remote (default, /auth/v1/user) | jwks (asymmetric JWKS cache)
AUTH_GOOGLE_ENABLED=                    # [pages] [browser] non-secret flag
AUTH_LINE_ENABLED=                      # [pages] [browser] non-secret flag
# DEV_AUTH_TOKEN                        # never set in production

# Note: JWKS mode requires asymmetric token signing (ES256/RS256). In JWKS mode,
# server-side sign-out/revocation is delayed until the access token expires.
# Rollback is performed by setting SUPABASE_VERIFIER_MODE=remote and redeploying.

# OAuth client secrets are configured in the Supabase dashboard, not here and
# never in a browser bundle.

# ---- Object storage (Cloudflare R2) --------------------------------------
R2_ACCOUNT_ID=                          # [railway] SECRET
R2_ACCESS_KEY_ID=                       # [railway] SECRET
R2_SECRET_ACCESS_KEY=                   # [railway] SECRET
R2_BUCKET=                              # [railway]
R2_PUBLIC_BASE_URL=                     # [railway] [pages] public asset origin

# ---- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=                         # [railway] SECRET
RESEND_FROM=                            # [railway]
CONTACT_NOTIFY_TO=                      # [railway]

# ---- Abuse controls ------------------------------------------------------
TURNSTILE_SECRET_KEY=                   # [railway] SECRET — Cloudflare Siteverify secret; production without it fails closed on all protected forms
TURNSTILE_SITE_KEY=                     # [railway] [pages] public widget key — embedded in rendered HTML and served via /api/storefront/bootstrap
MANUAL_TEST_CHECKOUT_UNTIL=             # [railway] RFC3339 UTC deadline enabling the manual_test payment method; empty/expired/malformed disables it; >24h ahead is rejected in production

# ---- Publishing ----------------------------------------------------------
CF_DEPLOY_HOOK_URL=                     # [railway] SECRET — deploy hook

# Values marked SECRET must never appear in admin/dist/ or
# site/themes/<theme>/dist/. Only the [browser] names cross that
# boundary, and the allowlist is enforced in both vite.config.ts files.

# ECPay AIO v5 (leave all blank to disable)
ECPAY_ENVIRONMENT=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
