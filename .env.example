# Local defaults: only DB_DRIVER / DATABASE_URL are needed.
APP_ENV=development
HTTP_ADDR=:8080
SITE_ADDR=:4173
SITE_ORIGIN=http://localhost:4173
PUBLIC_SITE_URL=http://localhost:4173
PUBLIC_API_BASE=http://localhost:8080

DB_DRIVER=sqlite
DATABASE_URL=file:var/site.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Local protected API calls use this token:
AUTH_MODE=dev
DEV_AUTH_TOKEN=dev-admin

# Production auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# R2 (optional locally)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Resend (optional locally; without this mail is logged)
RESEND_API_KEY=
RESEND_FROM=Site <hello@example.com>
CONTACT_NOTIFY_TO=

# Cloudflare Pages direct upload
CF_PAGES_PROJECT=
