# Compatibility template for the legacy root `.env`.
#
# `.env` still works and is still read for local development, so an existing
# setup keeps running unchanged. New setups should prefer:
#
#     cp .env.development.example .env.development.local
#
# Precedence for local runs: process environment > .env.development.local > .env
#
# For deployment, see `.env.production.example` and
# `docs/environment-configuration.md`. When APP_ENV=production this file — and
# every other repository dotenv file — is ignored.

# Local defaults: only DB_DRIVER / DATABASE_URL are needed.
APP_ENV=development
HTTP_ADDR=:8080
SITE_ADDR=:4173
SITE_ORIGIN=http://localhost:4173
PUBLIC_SITE_URL=http://localhost:4173
PUBLIC_API_BASE=http://localhost:8080

# Optional admin API prefix (default: /api for Vite dev proxy or same-origin deployment).
# When set for cross-origin admin deployment, MUST be a complete prefix ending in /api
# and use HTTPS (e.g. https://api.example.com/api). HTTP is allowed only for localhost/[::1]/127.0.0.1.
# Note: PUBLIC_API_BASE above is the public-site/backend origin; ADMIN_API_BASE is the admin client prefix.
# Leaving ADMIN_API_BASE unset preserves Vite's local /api proxy even when PUBLIC_API_BASE is defined.
# ADMIN_API_BASE=

DB_DRIVER=sqlite
DATABASE_URL=file:var/site.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Local protected API calls use this token:
# Frontend Vite builds read AUTH_MODE, SUPABASE_URL, and
# SUPABASE_PUBLISHABLE_KEY only. DEV_AUTH_TOKEN is never exposed.
AUTH_MODE=dev
DEV_AUTH_TOKEN=dev-admin

# Production auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Non-secret browser OAuth flags. Empty/false/unknown is fail-closed.
# Never put Google or LINE client secrets in this file or Vite define.
# Enable LINE only after the LINE channel has email permission.
AUTH_GOOGLE_ENABLED=false
AUTH_LINE_ENABLED=false

# R2 (optional locally)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Resend (optional locally; without this mail is logged)
RESEND_API_KEY=
RESEND_FROM=Site <hello@example.com>
CONTACT_NOTIFY_TO=

# Cloudflare Pages direct upload
CF_PAGES_PROJECT=

# ECPay AIO v5 (leave all blank to disable)
ECPAY_ENVIRONMENT=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
